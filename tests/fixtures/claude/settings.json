{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git branch -d)",
      "Bash(git branch -d *)",
      "Bash(git branch -D)",
      "Bash(git branch -D *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git config)",
      "Bash(git config *)",
      "Bash(gh)",
      "Bash(gh *)",
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git add *)",
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Write(**/.env*)",
      "Read(~/.claude/**)",
      "Edit(~/.claude/**)",
      "Write(~/.claude/**)",
      "Read(./.agent-team/**)",
      "Edit(./.agent-team/**)",
      "Write(./.agent-team/**)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Write(**/*.pem)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Write(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Write(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(~/.config/gcloud/**)",
      "Write(~/.config/gcloud/**)",
      "Read(~/.config/gh/**)",
      "Edit(~/.config/gh/**)",
      "Write(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Edit(~/.git-credentials)",
      "Write(~/.git-credentials)",
      "Read(~/.netrc)",
      "Edit(~/.netrc)",
      "Write(~/.netrc)",
      "Read(~/.docker/**)",
      "Edit(~/.docker/**)",
      "Write(~/.docker/**)",
      "Read(~/.kube/**)",
      "Edit(~/.kube/**)",
      "Write(~/.kube/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Write(~/.gnupg/**)",
      "Read(~/.azure/**)",
      "Edit(~/.azure/**)",
      "Write(~/.azure/**)",
      "Read(~/.config/op/**)",
      "Edit(~/.config/op/**)",
      "Write(~/.config/op/**)",
      "Read(~/.npmrc)",
      "Edit(~/.npmrc)",
      "Write(~/.npmrc)",
      "Read(~/.pypirc)",
      "Edit(~/.pypirc)",
      "Write(~/.pypirc)",
      "Read(~/.cargo/credentials)",
      "Edit(~/.cargo/credentials)",
      "Write(~/.cargo/credentials)",
      "Read(~/.cargo/credentials.toml)",
      "Edit(~/.cargo/credentials.toml)",
      "Write(~/.cargo/credentials.toml)",
      "Read(~/.m2/settings.xml)",
      "Edit(~/.m2/settings.xml)",
      "Write(~/.m2/settings.xml)",
      "Read(~/.gradle/gradle.properties)",
      "Edit(~/.gradle/gradle.properties)",
      "Write(~/.gradle/gradle.properties)",
      "Read(~/.vault-token)",
      "Edit(~/.vault-token)",
      "Write(~/.vault-token)",
      "Read(~/.terraform.d/credentials.tfrc.json)",
      "Edit(~/.terraform.d/credentials.tfrc.json)",
      "Write(~/.terraform.d/credentials.tfrc.json)",
      "Read(~/.config/containers/auth.json)",
      "Edit(~/.config/containers/auth.json)",
      "Write(~/.config/containers/auth.json)",
      "Read(~/.gem/credentials)",
      "Edit(~/.gem/credentials)",
      "Write(~/.gem/credentials)",
      "Read(~/.config/hub)",
      "Edit(~/.config/hub)",
      "Write(~/.config/hub)",
      "Read(~/.cache/huggingface/token)",
      "Edit(~/.cache/huggingface/token)",
      "Write(~/.cache/huggingface/token)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Write(**/*.key)",
      "Read(**/*.p12)",
      "Edit(**/*.p12)",
      "Write(**/*.p12)",
      "Read(**/*.pfx)",
      "Edit(**/*.pfx)",
      "Write(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Edit(**/id_rsa*)",
      "Write(**/id_rsa*)",
      "Read(**/id_ecdsa*)",
      "Edit(**/id_ecdsa*)",
      "Write(**/id_ecdsa*)",
      "Read(**/id_ed25519*)",
      "Edit(**/id_ed25519*)",
      "Write(**/id_ed25519*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "<PYTHON> -m agent_team.adapters.claude.hook <TMP>/compiled/policy.json"
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "fallbackModel": [
    "claude-sonnet-5-5"
  ]
}
