{
  "$defs": {
    "ReviewFinding": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Line"
        },
        "requirement_id": {
          "minLength": 1,
          "title": "Requirement Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "blocker",
            "major",
            "minor"
          ],
          "title": "Severity",
          "type": "string"
        },
        "fix": {
          "minLength": 1,
          "title": "Fix",
          "type": "string"
        }
      },
      "required": [
        "file",
        "line",
        "requirement_id",
        "severity",
        "fix"
      ],
      "title": "ReviewFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The independent reviewer's output: blocker and major findings make the verdict `changes`.",
  "properties": {
    "verdict": {
      "enum": [
        "approve",
        "changes",
        "escalate"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/ReviewFinding"
      },
      "title": "Findings",
      "type": "array"
    }
  },
  "required": [
    "verdict",
    "findings"
  ],
  "title": "ReviewVerdict",
  "type": "object"
}
